# ── AceVault configuration ──────────────────────────────────────────────
# The data provider controls where the site reads its content from.
#
#   "json"   → reads the local mock dataset in /data (default, no setup)
#   "strapi" → reads from a Strapi CMS API (see lib/data/strapi-adapter.ts)
NEXT_PUBLIC_DATA_PROVIDER=json

# Only required when NEXT_PUBLIC_DATA_PROVIDER=strapi
STRAPI_API_URL=https://cms.example.com/api
STRAPI_API_TOKEN=change-me
