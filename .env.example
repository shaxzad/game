# ── AceVault configuration ──────────────────────────────────────────────
# The data provider controls where the site reads its content from
# (see lib/data/index.ts). It is the ONLY switch needed to change sources.
#
#   "mongo"  → MongoDB Atlas, database google_play_monitor (see below)
#   "json"   → the local mock dataset in /data (no setup required)
#   "strapi" → a Strapi CMS API (see lib/data/strapi-adapter.ts)
#
# If NEXT_PUBLIC_DATA_PROVIDER is unset, the app auto-selects "mongo" when
# MONGODB_URI is present, otherwise falls back to "json".
NEXT_PUBLIC_DATA_PROVIDER=mongo

# ── MongoDB Atlas (provider = mongo) ────────────────────────────────────
# SERVER-ONLY. Never prefix with NEXT_PUBLIC_ — this must not reach the browser.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
DB_NAME=google_play_monitor

# ── Strapi (provider = strapi) ──────────────────────────────────────────
# Only required when NEXT_PUBLIC_DATA_PROVIDER=strapi
STRAPI_API_URL=https://cms.example.com/api
STRAPI_API_TOKEN=change-me

SCRAPE_DELAY_MS=1500
REVIEW_DELAY_MS=2000

GOOGLE_PLAY_COUNTRY=us
GOOGLE_PLAY_LANGUAGE=en